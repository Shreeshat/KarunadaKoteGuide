<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4E4BC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Karunada-Kote"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#7B1E00"/>
        </LinearLayout>

        <!-- MAIN CONTENT -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The stones still remember."
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="#7B1E00"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Now they will speak."
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="#7B1E00"/>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:src="@drawable/hero_fort"
                android:scaleType="centerCrop"
                android:layout_marginTop="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Karunada-Kote is your pocket historian for Karnataka's magnificent forts."
                android:textSize="18sp"
                android:textColor="#5C2E00"
                android:layout_marginTop="20dp"/>

            <!-- EXPLORE BUTTON -->

            <Button
                android:id="@+id/exploreBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CHOOSE YOUR FORT"
                android:layout_marginTop="24dp"
                android:backgroundTint="#7B1E00"/>

            <!-- HOW IT WORKS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How It Works"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#7B2100"
                android:layout_marginTop="30dp"
                android:paddingBottom="20dp"/>

            <!-- CARD 1 -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#F7E7C6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@android:drawable/ic_menu_mylocation"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Location Pings"
                        android:textStyle="bold"
                        android:textSize="22sp"
                        android:textColor="#8B2500"
                        android:paddingTop="14dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Simulated beacons trigger stories at fort landmarks."
                        android:textSize="18sp"
                        android:textColor="#4E342E"
                        android:paddingTop="10dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- CARD 2 -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#F7E7C6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@android:drawable/ic_lock_silent_mode_off"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bilingual Narration"
                        android:textStyle="bold"
                        android:textSize="22sp"
                        android:textColor="#8B2500"
                        android:paddingTop="14dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kannada and English historical narration."
                        android:textSize="18sp"
                        android:textColor="#4E342E"
                        android:paddingTop="10dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- CARD 3 -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#F7E7C6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@android:drawable/ic_menu_camera"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Photo Quests"
                        android:textStyle="bold"
                        android:textSize="22sp"
                        android:textColor="#8B2500"
                        android:paddingTop="14dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Capture fort memories and unlock achievements."
                        android:textSize="18sp"
                        android:textColor="#4E342E"
                        android:paddingTop="10dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- LOGOUT BUTTON -->

            <Button
                android:id="@+id/logoutBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:layout_marginTop="24dp"
                android:backgroundTint="#B22222"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>