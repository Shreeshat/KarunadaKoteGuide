<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4E4BC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/fortTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chitradurga Kote"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#7B1E00"/>

        <TextView
            android:id="@+id/fortDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="#4E342E"
            android:layout_marginTop="12dp"/>

        <ProgressBar
            android:id="@+id/storyProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:layout_marginTop="20dp"/>

        <TextView
            android:id="@+id/storyCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Story 1 / 3"
            android:textStyle="bold"
            android:textColor="#7B1E00"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/xpText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tourist XP: 0"
            android:textStyle="bold"
            android:textColor="#7B1E00"
            android:textSize="20sp"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/achievementText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Achievements Locked"
            android:textStyle="bold"
            android:textColor="#228B22"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/touristJourney"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Visited Forts: 0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#8B2100"
            android:layout_marginTop="10dp"/>

        <ImageView
            android:id="@+id/fortMap"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="20dp"
            android:scaleType="centerCrop"/>

        <Button
            android:id="@+id/playStoryBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Play Next Story"
            android:layout_marginTop="20dp"
            android:backgroundTint="#8B2100"/>

        <Button
            android:id="@+id/challengeBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Photo Challenge"
            android:layout_marginTop="12dp"
            android:backgroundTint="#D4A017"/>

        <Button
            android:id="@+id/languageBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Switch to Kannada"
            android:layout_marginTop="12dp"
            android:backgroundTint="#A0522D"/>

        <Button
            android:id="@+id/aiGuideBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ask AI Guide"
            android:layout_marginTop="12dp"
            android:backgroundTint="#228B22"/>

        <Button
            android:id="@+id/galleryBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tourist Gallery"
            android:layout_marginTop="12dp"
            android:backgroundTint="#5D4037"/>

        <Button
            android:id="@+id/mapBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OPEN LIVE MAP"
            android:layout_marginTop="12dp"
            android:backgroundTint="#1565C0"/>

        <ImageView
            android:id="@+id/capturedImage"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="20dp"
            android:scaleType="centerCrop"/>

    </LinearLayout>

</ScrollView>